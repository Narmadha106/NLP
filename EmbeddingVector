import os
import sys
import warnings
import numpy as np
import pandas as pd
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'


from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

import spacy

# Suppress warnings
warnings.simplefilter(action='ignore')
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'


# ==============================
# Load spaCy Model
# ==============================
try:
    nlp = spacy.load("en_core_web_sm")
except:
    print("Error: spaCy model 'en_core_web_sm' not found.")
    print("Install it using:")
    print("python -m spacy download en_core_web_sm")
    sys.exit(1)


# ==============================
# Main Function
# ==============================
def main():

    filename = input("Enter sports news text file name: ")

    filepath = os.path.join(sys.path[0], filename)

    # Check file exists
    if not os.path.isfile(filepath):
        print(f"Error: File '{filename}' not found.")
        sys.exit(1)

    # Read file
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            content = file.read()
    except:
        print("Error: Unable to read file.")
        sys.exit(1)

    # ==============================
    # Original Text Sample
    # ==============================
    print("\n=== Original Text Sample (First 300 chars) ===")
    print(content[:300])
    print()

    # ==============================
    # Preprocess Text
    # ==============================
    doc = nlp(content.lower())

    cleaned_tokens = []

    for token in doc:
        if not token.is_stop and not token.is_punct and not token.is_space:
            cleaned_tokens.append(token.text)

    print("=== Cleaned Text Sample ===")
    print(cleaned_tokens[:50])
    print()

    # ==============================
    # Split Documents (Using separators)
    # ==============================
    raw_docs = content.split("-----")

    documents = []

    for text in raw_docs:
        text = text.strip()

        if len(text) == 0:
            continue

        temp_doc = nlp(text.lower())

        words = []

        for token in temp_doc:
            if not token.is_stop and not token.is_punct and not token.is_space:
                words.append(token.text)

        documents.append(" ".join(words))

    # ==============================
    # Bag of Words
    # ==============================
    bow_vectorizer = CountVectorizer()
    bow_matrix = bow_vectorizer.fit_transform(documents)


    # ==============================
    # TF-IDF
    # ==============================
    tfidf_vectorizer = TfidfVectorizer()
    tfidf_matrix = tfidf_vectorizer.fit_transform(documents)

    feature_names = tfidf_vectorizer.get_feature_names()
    idf_values = tfidf_vectorizer.idf_


    # ==============================
    # Display TF-IDF Features
    # ==============================
    print("=== TF-IDF Features ===")
    print(list(feature_names))
    print()


    # ==============================
    # Display IDF Values
    # ==============================
    print("=== IDF Values ===")

    for word, value in zip(feature_names, idf_values):
        print(f"{word} : {value:.4f}")

    print()


    # ==============================
    # TF-IDF Matrix DataFrame
    # ==============================
    tfidf_df = pd.DataFrame(
        tfidf_matrix.toarray(),
        columns=feature_names
    )

    tfidf_df = tfidf_df.round(4)

    print("=== TF-IDF Matrix ===")
    print(tfidf_df)
    print()


    # ==============================
    # Word Embeddings
    # ==============================
    embeddings = []

    for doc_text in documents:
        vec = nlp(doc_text).vector
        embeddings.append(vec)

    embeddings = np.array(embeddings)

    print("=== Word Embedding Vectors ===")
    print(embeddings)
    print()


    # ==============================
    # Vector Shapes
    # ==============================
    print("=== Vector Shapes ===")

    print("BoW shape:", bow_matrix.shape)
    print("TF-IDF shape:", tfidf_matrix.shape)
    print("Embedding shape:", embeddings.shape)

    print()


    # ==============================
    # Cosine Similarity
    # ==============================
    bow_sim = cosine_similarity(bow_matrix)
    tfidf_sim = cosine_similarity(tfidf_matrix)
    embed_sim = cosine_similarity(embeddings)


    print("=== Cosine Similarity (BoW) ===")
    print(bow_sim)
    print()

    print("=== Cosine Similarity (TF-IDF) ===")
    print(tfidf_sim)
    print()

    print("=== Cosine Similarity (Embeddings) ===")
    print(embed_sim)
    print()


    # ==============================
    # Observations
    # ==============================
    print("=== Observations ===")

    print("1. Bag-of-Words considers only word frequency.")
    print("2. TF-IDF highlights important words across documents.")
    print("3. Word embeddings capture semantic meaning and context.")
    print("4. Embedding similarity reflects deeper relationships between sports news articles.")


# ==============================
# Run Program
# ==============================
if __name__ == "__main__":
    main()
