    sys.exit(1)

with open(file_path, "r", encoding="utf-8") as f:
    content = f.read()

print("=== Original Text Sample (First 300 chars) ===")
print(content[:300])
print()

doc = nlp(content.lower())

clean_tokens = [
    token.text
    for token in doc
    if token.is_alpha
    and not token.is_stop
    and not token.is_space
]

print("=== Cleaned Text Sample ===")
print(" ".join(clean_tokens[:50]))
print()

documents = [" ".join(clean_tokens)]

vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform(documents)

features = vectorizer.get_feature_names()
idf_values = vectorizer.idf_

print("=== TF-IDF Features ===")
print(list(features))
print()

print("=== IDF Values ===")
for word, idf in zip(features, idf_values):
    print(f"{word:<20} : {idf:.4f}")
print()

df = pd.DataFrame(tfidf_matrix.toarray(), columns=features)
print("=== TF-IDF Matrix ===")
print(df.round(4))
