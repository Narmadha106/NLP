import os
import sys
import warnings

# Suppress warnings
os.environ["TF_CPP_MIN_LOG_LEVEL"] = "3"
warnings.simplefilter(action='ignore')

import spacy

# Load spaCy model
try:
    nlp = spacy.load("en_core_web_sm")
except:
    print("SpaCy model 'en_core_web_sm' not found. Install it using:")
    print("python -m spacy download en_core_web_sm")
    sys.exit(1)

# Input file
filename = input("Enter text file name: ").strip()
file_path = os.path.join(sys.path[0], filename)

# Read file
try:
    with open(file_path, "r", encoding="utf-8") as file:
        text = file.read()
except FileNotFoundError:
    print(f"Error: File '{filename}' not found.")
    sys.exit(1)

# Display first 300 characters
print("=== Original Text Sample (First 300 chars) ===")
print(text[:300])
print()

# Process text with spaCy
doc = nlp(text)

# ----------------------
# Sentences with PERSON as Main Subject
# ----------------------
print("=== Sentences with PERSON as Main Subject ===")

for sent in doc.sents:
    # Parse the sentence
    sent_doc = nlp(sent.text)

    # Initialize subject and verb
    subject = None
    verb = None

    for token in sent_doc:
        # Find main subject
        if "subj" in token.dep_ and token.ent_type_ == "PERSON":
            subject = token.text
        # Find main verb (ROOT of the sentence)
        if token.dep_ == "ROOT":
            verb = token.text

    if subject and verb:
        print(f"Sentence : {sent.text.strip()}")
        print(f"Subject  : {subject} Main Verb: {verb}")
        print("-" * 50)
